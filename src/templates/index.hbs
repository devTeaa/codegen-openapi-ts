{{>header}}

{{#if @root.exportClient}}
export { {{{clientName}}} } from './{{{clientName}}}.js';

{{/if}}
{{#if @root.exportCore}}
export { ApiError } from './core/ApiError.js';
{{#if @root.exportClient}}
export { BaseHttpRequest } from './core/BaseHttpRequest.js';
{{/if}}
export { CancelablePromise, CancelError } from './core/CancelablePromise.js';
export { OpenAPI } from './core/OpenAPI.js';
export type { OpenAPIConfig } from './core/OpenAPI.js';
{{/if}}
{{#if @root.exportModels}}
{{#if models}}

{{#each models}}
{{#if @root.useUnionTypes}}
export type { {{{name}}}{{#if @root.postfixModels}} as {{{name}}}{{{@root.postfixModels}}}{{/if}} } from './models/{{{name}}}.js';
{{else if enum}}
export { {{{name}}}{{#if @root.postfixModels}} as {{{name}}}{{{@root.postfixModels}}}{{/if}} } from './models/{{{name}}}.js';
{{else if enums}}
export { {{{name}}}{{#if @root.postfixModels}} as {{{name}}}{{{@root.postfixModels}}}{{/if}} } from './models/{{{name}}}.js';
{{else}}
export type { {{{name}}}{{#if @root.postfixModels}} as {{{name}}}{{{@root.postfixModels}}}{{/if}} } from './models/{{{name}}}.js';
{{/if}}
{{/each}}
{{/if}}
{{/if}}
{{#if @root.exportSchemas}}
{{#if models}}

{{#each models}}
export { ${{{name}}} } from './schemas/${{{name}}}.js';
{{/each}}
{{/if}}
{{/if}}
{{#if @root.exportServices}}
{{#if services}}

{{#each services}}
export { {{{name}}}{{{@root.postfixServices}}} } from './services/{{{name}}}{{{@root.postfixServices}}}.js';
export { {{{name}}}{{{@root.postfixServices}}}Url } from './services/{{{name}}}{{{@root.postfixServices}}}.js';
{{/each}}
{{/if}}
{{/if}}
